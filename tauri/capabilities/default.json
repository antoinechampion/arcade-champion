{
  "identifier": "default",
  "description": "Default capabilities for Arcade Champion",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/arcade-champion-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
