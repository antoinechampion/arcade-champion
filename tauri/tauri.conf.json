{
  "$schema": "https://raw.githubusercontent.com/nicoulaj/tauri/v2/packages/cli/schema.json",
  "productName": "Arcade Champion",
  "version": "0.1.0",
  "identifier": "com.arcade-champion.app",
  "build": {
    "beforeBuildCommand": "npm run build --prefix front-end",
    "beforeDevCommand": "npm run dev --prefix front-end",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../front-end/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcade Champion",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "width": 1920,
        "height": 1080
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
      "icon": [
        "icons/icon.png",
        "icons/icon.ico"
      ]
  },
  "plugins": {}
}
